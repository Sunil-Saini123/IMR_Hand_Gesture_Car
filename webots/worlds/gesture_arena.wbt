#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  info [
    "Gesture-guided e-puck: 4 x 4 m arena with three boxes and four landmark posts."
    "Coordinates are ENU (z up). Landmark positions and the start pose are mirrored in config.yaml."
  ]
  title "Gesture Arena"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.402728 0.402728 0.821961 1.765615
  position 0 -3.9 4.9
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Floor {
  size 4 4
  appearance PBRAppearance {
    baseColor 0.82 0.84 0.82
    roughness 1
    metalness 0
  }
}
Solid {
  translation 0 2 0.15
  children [
    DEF WALL_X_SHAPE Shape {
      appearance DEF WALL_APPEARANCE PBRAppearance {
        baseColor 0.25 0.28 0.32
        roughness 1
        metalness 0
      }
      geometry DEF WALL_X_BOX Box {
        size 4 0.1 0.3
      }
    }
  ]
  name "north_wall"
  boundingObject USE WALL_X_BOX
}
Solid {
  translation 0 -2 0.15
  children [
    USE WALL_X_SHAPE
  ]
  name "south_wall"
  boundingObject USE WALL_X_BOX
}
Solid {
  translation -2 0 0.15
  children [
    DEF WALL_Y_SHAPE Shape {
      appearance USE WALL_APPEARANCE
      geometry DEF WALL_Y_BOX Box {
        size 0.1 4 0.3
      }
    }
  ]
  name "west_wall"
  boundingObject USE WALL_Y_BOX
}
Solid {
  translation 2 0 0.15
  children [
    USE WALL_Y_SHAPE
  ]
  name "east_wall"
  boundingObject USE WALL_Y_BOX
}
Solid {
  translation -0.55 0.45 0.12
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.35 0.2
        roughness 1
        metalness 0
      }
      geometry DEF OBSTACLE_1_BOX Box {
        size 0.55 0.55 0.24
      }
    }
  ]
  name "obstacle_1"
  boundingObject USE OBSTACLE_1_BOX
}
Solid {
  translation 0.65 -0.35 0.12
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.45 0.75
        roughness 1
        metalness 0
      }
      geometry DEF OBSTACLE_2_BOX Box {
        size 0.45 0.8 0.24
      }
    }
  ]
  name "obstacle_2"
  boundingObject USE OBSTACLE_2_BOX
}
Solid {
  translation 0.2 1.1 0.12
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.25 0.6 0.35
        roughness 1
        metalness 0
      }
      geometry DEF OBSTACLE_3_BOX Box {
        size 0.65 0.3 0.24
      }
    }
  ]
  name "obstacle_3"
  boundingObject USE OBSTACLE_3_BOX
}
DEF LANDMARK_1 Solid {
  translation -1.2 -0.5 0.15
  children [
    DEF LANDMARK_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.75 0.1
        roughness 0.6
        metalness 0
      }
      geometry DEF LANDMARK_CYLINDER Cylinder {
        height 0.3
        radius 0.05
      }
    }
  ]
  name "landmark_1"
  boundingObject USE LANDMARK_CYLINDER
}
DEF LANDMARK_2 Solid {
  translation 1.3 0.6 0.15
  children [
    USE LANDMARK_SHAPE
  ]
  name "landmark_2"
  boundingObject USE LANDMARK_CYLINDER
}
DEF LANDMARK_3 Solid {
  translation -1.2 1.3 0.15
  children [
    USE LANDMARK_SHAPE
  ]
  name "landmark_3"
  boundingObject USE LANDMARK_CYLINDER
}
DEF LANDMARK_4 Solid {
  translation 0 -1.3 0.15
  children [
    USE LANDMARK_SHAPE
  ]
  name "landmark_4"
  boundingObject USE LANDMARK_CYLINDER
}
E-puck {
  translation -1.5 -1.5 0
  name "gesture_epuck"
  controller "robot_controller"
  supervisor TRUE
  turretSlot [
    Lidar {
      translation 0.0095 0 0.012
      children [
        Pose {
          translation 0 0 -0.007
          children [
            Shape {
              appearance PBRAppearance {
                baseColor 0.1 0.1 0.12
                roughness 0.5
                metalness 0
              }
              geometry Cylinder {
                height 0.008
                radius 0.012
              }
            }
          ]
        }
      ]
      name "lidar"
      horizontalResolution 360
      fieldOfView 6.28318
      verticalFieldOfView 0.1
      numberOfLayers 1
      near 0.01
      minRange 0.02
      maxRange 2
      noise 0.002
    }
  ]
